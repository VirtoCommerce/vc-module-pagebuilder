<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <noWarn>1591;NU1608</noWarn>
    <IsPackable>False</IsPackable>
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\VirtoCommerce.PageBuilderModule.Core\VirtoCommerce.PageBuilderModule.Core.csproj" />
    <ProjectReference Include="..\VirtoCommerce.PageBuilderModule.Data.MySql\VirtoCommerce.PageBuilderModule.Data.MySql.csproj" />
    <ProjectReference Include="..\VirtoCommerce.PageBuilderModule.Data.PostgreSql\VirtoCommerce.PageBuilderModule.Data.PostgreSql.csproj" />
    <ProjectReference Include="..\VirtoCommerce.PageBuilderModule.Data.SqlServer\VirtoCommerce.PageBuilderModule.Data.SqlServer.csproj" />
    <ProjectReference Include="..\VirtoCommerce.PageBuilderModule.Data\VirtoCommerce.PageBuilderModule.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VirtoCommerce.PageBuilderModule.Tests" />
  </ItemGroup>
  
  <ItemGroup>
    <Content Include="ai\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <AiFolder Include="ai\**" />
  </ItemGroup>

  <Target Name="CopyCustomContentOnPublish" AfterTargets="Publish">
    <Copy SourceFiles="@(PageBuilderApp)" DestinationFiles="$(PublishDir)\..\%(Identity)" />
    <Copy SourceFiles="@(AiFolder)" DestinationFiles="$(PublishDir)\..\%(Identity)" />
  </Target>
  <!-- Admin Shell plugin: Vue sources in vue/, built into plugins/admin-shell/ -->
  <ItemGroup>
    <Compile Remove="vue\**" />
    <Content Remove="vue\**" />
    <EmbeddedResource Remove="vue\**" />
    <None Remove="vue\**" />
    <Content Remove="plugins\**" />
    <None Remove="plugins\**" />
    <AdminShellPlugin Include="plugins\**" />
  </ItemGroup>
  <Target Name="CopyAdminShellPluginOnPublish" AfterTargets="Publish">
    <Copy SourceFiles="@(AdminShellPlugin)" DestinationFiles="$(PublishDir)\..\%(Identity)" />
  </Target>
</Project>
{
  "name": "pagebuilder-admin",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "serve": "cross-env APP_ENV=development vite --force",
    "build": "cross-env APP_ENV=production vite build",
    "build:standalone": "cross-env APP_ENV=production vite build --config vite.standalone.config.mts",
    "build:types": "vue-tsc --declaration --emitDeclarationOnly --outDir dist/types",
    "type-check": "vue-tsc --noEmit",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "generate-api-client": "cross-env api-client-generator --APP_PLATFORM_MODULES='[VirtoCommerce.PageBuilderModule,VirtoCommerce.Assets]' --APP_API_CLIENT_DIRECTORY=./src/api_client/ --APP_OUT_DIR=dist --APP_PACKAGE_NAME=api --APP_PACKAGE_VERSION=$npm_package_version --APP_TYPE_STYLE=Interface"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.10.5",
    "@types/sortablejs": "^1",
    "@vc-shell/api-client-generator": "2.7.0",
    "@vc-shell/ts-config": "2.7.0",
    "autoprefixer": "^10.4.27",
    "cross-env": "^7.0.3",
    "postcss": "^8.5.13",
    "sass": "^1.87.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "vue-tsc": "^3.2.5"
  },
  "dependencies": {
    "@vc-shell/config-generator": "2.7.0",
    "@vc-shell/framework": "2.7.0",
    "@vc-shell/mf-module": "2.7.0",
    "@vueuse/core": "^10.11.1",
    "@vueuse/integrations": "^10.11.1",
    "lodash-es": "^4.18.1",
    "sortablejs": "^1.15.7",
    "vee-validate": "^4.12.4",
    "vue": "^3.5.30",
    "vue-router": "^5.0.3"
  },
  "packageManager": "yarn@4.9.1"
}

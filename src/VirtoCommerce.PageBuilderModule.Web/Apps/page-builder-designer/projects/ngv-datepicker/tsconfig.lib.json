{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "target": "ES2022",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "useDefineForClassFields": false,
    "types": [],
    "lib": ["dom", "es2022"]
  },
  "angularCompilerOptions": {
    "strictInjectionParameters": true
  },
  "exclude": ["**/*.spec.ts", "**/*.test.ts"],
  "include": ["**/*.ts"]
}

{
    "storefrontUrl": {
        "init": "requests",
        "requests": [
            {
                "url": "/api/stores/{{location.params.storeId}}",
                "method": "GET",
                "cacheable": true,
                "response": {
                    "result": "$.url",
                    "isArray": false
                }
            },
            {
                "url": "/api/platform/settings/VirtoCommerce.PageBuilderModule.General.StoreUrl",
                "method": "GET",
                "response": {
                    "result": "$.value",
                    "isArray": false
                }
            }
        ]
    },
    "previewPath": {
        "init": "requests",
        "requests": [
            {
                "url": "/api/platform/settings/VirtoCommerce.PageBuilderModule.General.StorePreviewPath",
                "method": "GET",
                "cacheable": true,
                "response": {
                    "result": "$.value",
                    "isArray": false
                }
            },
            {
                "url": "/api/platform/settings/VirtoCommerce.PageBuilderModule.General.StorePreviewPath",
                "method": "GET",
                "cacheable": true,
                "response": {
                    "result": "$.defaultValue",
                    "isArray": false
                }
            }
        ]
    },
    "fullPreviewUrl": "{{=combine(this.settings.storefrontUrl, this.settings.previewPath)}}?ep={{location.origin}}",
    "themeName": {
        "init": true,
        "url": "/api/stores/{{location.params.storeId}}",
        "method": "GET",
        "response": {
            "result": "$.dynamicProperties..values[?(@.propertyName=='DefaultThemeName')].value",
            "isArray": false
        },
        "fallbackValue": "default"
    },
    "templatesListUrl": "/api/pagebuilder/templates?storeId={{location.params.storeId}}&theme={{config.themeName}}",
    "sectionsListUrl": "/api/pagebuilder/sections?storeId={{location.params.storeId}}&theme={{config.themeName}}",
    "templateUrl": {
        "default": "/api/pagebuilder/template?storeId={{location.params.storeId}}&theme={{config.themeName}}&path={{path}}&type={{type}}&draft=true",
        "pages": [
            {
                "url": "/api/page-builder-pages/grouped/{{location.params.groupId}}/content",
                "method": "GET",
                "fallbackValue": "{\"settings\":{},\"content\": []}"
            },
            "/api/pagebuilder/template?storeId={{location.params.storeId}}&theme={{config.themeName}}&path={{path}}&type=pages&draft=true"
        ],
        "blogs": "/api/pagebuilder/template?storeId={{location.params.storeId}}&theme={{config.themeName}}&path={{path}}&type=blogs&draft=true"
    },
    "saveTemplates": {
        "url": "/api/pagebuilder/save?storeId={{location.params.storeId}}&theme={{config.themeName}}&draft=true",
        "method": "POST",
        "body": {
            "files": "{{=JSON.stringify(this.templatesToSave.map(x => ({ path: x.entry.path, groupId: x.entry.groupId, type: x.entry.type, content: x.content })))}}"
        }
    },
    "saveGroupedPage": {
        "url": "/api/page-builder-pages/grouped/{{location.params.groupId}}/content",
        "method": "POST",
        "body": "{{=JSON.stringify(this.content, null, 2)}}"
    },
    "publish": {
        "status": "/api/content/{{type}}/{{location.params.storeId}}/publish-status?relativeUrl={{path}}",
        "publish": {
            "url": "/api/content/{{type}}/{{location.params.storeId}}/publishing?relativeUrl={{path}}&publish=true",
            "method": "POST"
        },
        "unpublish": {
            "url": "/api/content/{{type}}/{{location.params.storeId}}/publishing?relativeUrl={{path}}&publish=false",
            "method": "POST"
        }
    },
    "publishPages": {
        "status": "/api/page-builder-pages/grouped/publish-status/{{groupId}}",
        "publish": {
            "url": "/api/page-builder-pages/grouped/publishing/{{groupId}}?publish=true",
            "method": "POST"
        },
        "unpublish": {
            "url": "/api/page-builder-pages/grouped/publishing/{{groupId}}?publish=false",
            "method": "POST"
        }
    },
    "externalPreview": {
        "url": "{{=combine(this.settings.storefrontUrl, '/designer-preview?pageId=' + (this.groupId || this.location.params.previewId))}}"
    },
    "settingsDataRequest": "/api/pagebuilder/template?storeId={{location.params.storeId}}&path={{settings.settingsPath}}&type=themes",
    "settingsSchemaRequest": "/api/pagebuilder/template?storeId={{location.params.storeId}}&path={{config.themeName}}/config/settings_schema.json&type=themes",
    "saveSettings": {
        "url": "/api/pagebuilder/save?storeId={{location.params.storeId}}&theme={{config.themeName}}",
        "method": "POST",
        "body": {
            "files": "[{\"path\": \"{{settings.settingsPath}}\", \"type\": \"themes\", \"content\": {{item}}}]"
        }
    },
    "settingsPath": "{{config.themeName}}/config/settings_data.json",
    "defaultPreviewUrl": "/",
    "assetLibraryRootFolderUrl": "/stores/{{storeId}}/Page Builder",
    "assetsUrlTemplate": "{{=(function(url) { if (!url) return ''; var trimmed = url.trim(); if (!trimmed) return ''; if (/^(?:[a-z][a-z\\d+\\-.]*:)?\\/\\//i.test(trimmed) || trimmed.indexOf('data:') === 0) return trimmed; var normalized = trimmed.charAt(0) === '/' ? trimmed : '/' + trimmed; return normalized.toLowerCase().indexOf('/assets/') === 0 ? normalized : combine('/assets', normalized); })(this.assetUrl)}}",
    "assetPreviewUrlTemplate": "{{=(function(publicUrl, modifiedDate) { if (!publicUrl || !modifiedDate) return publicUrl; return publicUrl + (publicUrl.indexOf('?') >= 0 ? '&' : '?') + 't=' + encodeURIComponent(modifiedDate); })(this.publicAssetUrl, this.modifiedDate)}}",
    "assetLibrarySearchRequest": "/api/assets?folderUrl={{=encodeURIComponent(this.folderUrl)}}{{=this.keyword ? '&keyword=' + encodeURIComponent(this.keyword) : ''}}",
    "assetLibraryUploadRequest": {
        "url": "/api/assets?folderUrl={{=encodeURIComponent(this.folderUrl)}}",
        "method": "POST",
        "form": {
            "name": "file",
            "fileName": "{{file.name}}"
        }
    },
    "uploadAssetsRequest": {
        "url": "/api/assets?folderUrl={{=encodeURIComponent(this.folderUrl)}}&name={{file.assetName}}",
        "method": "POST",
        "form": {
            "name": "file",
            "fileName": "{{file.assetName}}"
        },
        "response": {
            "selector": "this.response && this.response[0] ? (this.response[0].url || this.response[0].relativeUrl || null) : null",
            "isArray": false
        }
    },
    "skipTheme": {
        "init": true,
        "url": "/api/platform/security/currentuser",
        "method": "GET",
        "cacheable": true,
        "response": {
            "selector": "this.response.permissions.indexOf('builder:theme') === -1",
            "isArray": false
        }
    },
    "previewImpersonation": {
      "init": true,
      "url": "/api/stores/{{location.params.storeId}}",
      "method": "GET",
      "cacheable": true,
      "response": {
        "selector": "(function() { var s = (this.response.settings || []).find(function(x) { return x.name === 'VirtoCommerce.PageBuilderModule.Store.PreviewUserIds' }); return s && s.value ? s.value.split('\\n').map(function(x) { return x.trim() }).filter(Boolean) : [] }).call(this)",
        "isArray": true
      }
    },
    "previewAccounts": {
        "url": "/api/platform/security/users/search",
        "method": "POST",
        "body": {
            "objectIds": "@{{this.settings.previewImpersonation || []}}",
            "take": 100
        },
        "response": {
            "selector": "(this.response.results || []).map(function(u) { return { id: u.id, name: u.userName || u.email || u.id, photoUrl: u.photoUrl || null } })",
            "isArray": true
        }
    },
    "skipTemplates": {
        "init": true,
        "url": "/api/platform/security/currentuser",
        "method": "GET",
        "cacheable": true,
        "response": {
            "selector": "this.response.permissions.indexOf('builder:templates') === -1",
            "isArray": false
        }
    },
    "canInsertLinkedComponents": {
        "init": true,
        "url": "/api/platform/security/currentuser",
        "method": "GET",
        "cacheable": true,
        "response": {
            "selector": "this.response.isAdministrator === true || (this.response.permissions || []).indexOf('builder:linked-components:read') !== -1",
            "isArray": false
        }
    },
    "canCreateLinkedComponents": {
        "init": true,
        "url": "/api/platform/security/currentuser",
        "method": "GET",
        "cacheable": true,
        "response": {
            "selector": "this.response.isAdministrator === true || (this.response.permissions || []).indexOf('builder:linked-components:create') !== -1",
            "isArray": false
        }
    },
    "canEditLinkedComponents": {
        "init": true,
        "url": "/api/platform/security/currentuser",
        "method": "GET",
        "cacheable": true,
        "response": {
            "selector": "this.response.isAdministrator === true || (this.response.permissions || []).indexOf('builder:linked-components:update') !== -1",
            "isArray": false
        }
    },
    "canDeleteLinkedComponents": {
        "init": true,
        "url": "/api/platform/security/currentuser",
        "method": "GET",
        "cacheable": true,
        "response": {
            "selector": "this.response.isAdministrator === true || (this.response.permissions || []).indexOf('builder:linked-components:delete') !== -1",
            "isArray": false
        }
    }
}

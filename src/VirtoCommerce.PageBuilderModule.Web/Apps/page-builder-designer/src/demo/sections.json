        "blocks": [],
        "settings": []
    },
    "text": {
        "name": "Text",
        "icon": "text",
        "blocks": [],
        "settings": []
    },
    "image": {
        "name": "Image",
        "icon": "image",
        "settings": []
    },
    "products-list": {
        "name": "Products collection",
        "icon": "collection",
        "blocks": ["category-description"],
        "settings": []
    },
    "gallery": {
        "name": "Gallery",
        "icon": "gallery",
        "blocks": [],
        "settings": []
    }
}

{
    "name": "template-builder",
    "version": "0.0.0",
    "scripts": {
        "watch": "ng build --watch --configuration development",
        "build": "ng build ngv-markdown && ng build ngv-datepicker && npm run build:datepicker:themes && ng build",
        "build:datepicker": "ng build ngv-datepicker && npm run build:datepicker:themes",
        "build:datepicker:themes": "sass --load-path=node_modules --silence-deprecation=global-builtin --silence-deprecation=import --silence-deprecation=if-function projects/ngv-datepicker/src/lib/prebuilt-themes:.dist-libs/ngv-datepicker/prebuilt-themes --style=compressed",
        "ng": "ng",
        "start": "ng serve",
        "test": "ng test",
        "lint": "ng lint"
    },
    "private": true,
    "workspaces": [
        "projects/ngv-markdown",
        "projects/ngv-datepicker"
    ],
    "dependencies": {
        "@angular/animations": "^20.3.18",
        "@angular/cdk": "^20.2.14",
        "@angular/common": "^20.3.18",
        "@angular/compiler": "^20.3.18",
        "@angular/core": "^20.3.18",
        "@angular/forms": "^20.3.18",
        "@angular/material": "^20.2.14",
        "@angular/platform-browser": "^20.3.18",
        "@angular/platform-browser-dynamic": "^20.3.18",
        "@angular/router": "^20.3.18",
        "@iplab/ngx-file-upload": "^20.0.1",
        "@ng-select/ng-select": "^20.7.0",
        "@ngrx/effects": "^20.1.0",
        "@ngrx/router-store": "^20.1.0",
        "@ngrx/store": "^20.1.0",
        "chrono-node": "^2.9.0",
        "ckeditor4": "^4.25.1",
        "ckeditor4-angular": "^5.2.1",
        "jsonpath-plus": "^10.4.0",
        "lodash-es": "^4.17.21",
        "ngx-color": "^10.1.0",
        "ngx-cookie-service": "^20.1.1",
        "ngx-scrollbar": "^19.1.4",
        "ngx-toastr": "^19.1.0",
        "rxjs": "^7.8.2",
        "tslib": "^2.4.0",
        "zone.js": "~0.15.1"
    },
    "devDependencies": {
        "@ngrx/store-devtools": "^20.1.0",
        "@angular-devkit/architect": "^0.2003.20",
        "@angular-devkit/build-angular": "^20.3.20",
        "@angular-devkit/core": "^20.3.20",
        "@angular-eslint/builder": "^20.7.0",
        "@angular-eslint/eslint-plugin": "^20.7.0",
        "@angular-eslint/eslint-plugin-template": "^20.7.0",
        "@angular-eslint/schematics": "^20.7.0",
        "@angular-eslint/template-parser": "^20.7.0",
        "@eslint/eslintrc": "^3.0.0",
        "@eslint/js": "^9.0.0",
        "@angular/cli": "^20.3.20",
        "@angular/compiler-cli": "^20.3.18",
        "@tailwindcss/forms": "^0.5.2",
        "@tailwindcss/typography": "^0.5.2",
        "@types/jasmine": "^5.1.15",
        "@types/lodash-es": "^4.17.6",
        "@types/node": "^20.19.37",
        "@types/turndown": "^5.0.1",
        "@typescript-eslint/parser": "^8.33.1",
        "@typescript-eslint/types": "^8.0.0",
        "@typescript-eslint/utils": "^8.33.1",
        "eslint": "^9.28.0",
        "jasmine-core": "^5.13.0",
        "karma": "^6.4.4",
        "karma-chrome-launcher": "^3.2.0",
        "karma-coverage": "~2.2.0",
        "karma-jasmine": "^5.1.0",
        "karma-jasmine-html-reporter": "^2.2.0",
        "ng-packagr": "^20.3.2",
        "postcss": "^8.4.14",
        "sass": "^1.69.0",
        "tailwindcss": "^3.0.24",
        "typescript": "~5.8.3"
    },
    "packageManager": "yarn@1.22.21+sha1.1959a18351b811cdeedbd484a8f86c3cc3bbaf72"
}

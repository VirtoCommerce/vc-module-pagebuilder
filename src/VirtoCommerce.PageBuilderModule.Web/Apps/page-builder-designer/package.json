{
    "name": "template-builder",
    "version": "0.0.0",
    "scripts": {
        "watch": "ng build --watch --configuration development",
        "build": "ng build ngv-markdown && ng build ngv-datepicker && npm run build:datepicker:themes && ng build",
        "build:datepicker": "ng build ngv-datepicker && npm run build:datepicker:themes",
        "build:datepicker:themes": "sass --load-path=node_modules --silence-deprecation=global-builtin --silence-deprecation=import --silence-deprecation=if-function projects/ngv-datepicker/src/lib/prebuilt-themes:.dist-libs/ngv-datepicker/prebuilt-themes --style=compressed",
        "ng": "ng",
        "start": "ng serve",
        "test": "ng test template-builder",
        "test:watch": "ng test template-builder --watch",
        "test:coverage": "ng test template-builder --coverage",
        "lint": "ng lint"
    },
    "private": true,
    "workspaces": [
        "projects/ngv-markdown",
        "projects/ngv-datepicker"
    ],
    "dependencies": {
        "@angular/animations": "^21.2.5",
        "@angular/cdk": "^21.2.3",
        "@angular/common": "^21.2.5",
        "@angular/compiler": "^21.2.5",
        "@angular/core": "^21.2.5",
        "@angular/forms": "^21.2.5",
        "@angular/material": "^21.2.3",
        "@angular/platform-browser": "^21.2.5",
        "@angular/platform-browser-dynamic": "^21.2.5",
        "@angular/router": "^21.2.5",
        "@iplab/ngx-file-upload": "^21.0.0",
        "@ng-select/ng-select": "^21.5.2",
        "@ngrx/effects": "^21.0.1",
        "@ngrx/router-store": "^21.0.1",
        "@ngrx/store": "^21.0.1",
        "chrono-node": "^2.9.0",
        "ckeditor4": "4.21.0",
        "ckeditor4-angular": "^5.2.1",
        "jsonpath-plus": "^10.4.0",
        "lodash-es": "^4.17.23",
        "ngx-color": "^10.1.0",
        "ngx-cookie-service": "^21.3.1",
        "ngx-scrollbar": "^19.1.4",
        "ngx-toastr": "^20.0.5",
        "rxjs": "^7.8.2",
        "tslib": "^2.8.1"
    },
    "devDependencies": {
        "@angular-devkit/architect": "^0.2100.6",
        "@angular-devkit/build-angular": "^21.2.3",
        "@angular-devkit/core": "^21.2.3",
        "@angular-eslint/builder": "^21.3.1",
        "@angular-eslint/eslint-plugin": "^21.3.1",
        "@angular-eslint/eslint-plugin-template": "^21.3.1",
        "@angular-eslint/schematics": "^21.3.1",
        "@angular-eslint/template-parser": "^21.3.1",
        "@angular/build": "^21.2.3",
        "@angular/cli": "^21.2.3",
        "@angular/compiler-cli": "^21.2.5",
        "@eslint/eslintrc": "^3.3.5",
        "@eslint/js": "^9.39.4",
        "@ngrx/store-devtools": "^21.0.1",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/typography": "^0.5.19",
        "@types/lodash-es": "^4.17.12",
        "@types/node": "^20.19.37",
        "@types/turndown": "^5.0.6",
        "@typescript-eslint/parser": "^8.57.2",
        "@typescript-eslint/types": "^8.57.2",
        "@typescript-eslint/utils": "^8.57.2",
        "eslint": "^9.39.4",
        "jsdom": "^29.0.1",
        "ng-packagr": "^21.2.1",
        "postcss": "^8.5.8",
        "prettier": "^3.8.1",
        "sass": "^1.98.0",
        "tailwindcss": "^3.4.19",
        "typescript": "~5.9.3",
        "vitest": "^4.1.1"
    },
    "packageManager": "yarn@1.22.21+sha1.1959a18351b811cdeedbd484a8f86c3cc3bbaf72"
}
